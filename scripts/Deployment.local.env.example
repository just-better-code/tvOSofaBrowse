# Copy to scripts/Deployment.local.env; keep actual values out of Git.
# Use the UUID of an Apple TV you have explicitly authorized for delivery.
TV_DEVICE_ID="${TV_DEVICE_ID:-YOUR_APPLE_TV_UUID}"
# Must match PRODUCT_BUNDLE_IDENTIFIER in Signing.local.xcconfig.
TV_EXPECTED_BUNDLE_IDENTIFIER="${TV_EXPECTED_BUNDLE_IDENTIFIER:-org.example.your.tvosbrowser}"
